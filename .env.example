# Supabase PostgreSQL. Copy exact host/user from Supabase > Connect.
# URL-encode special characters in the database password.
# Runtime: transaction pooler (6543), compatible with Prisma 6 / Vercel.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=3&pool_timeout=20&sslmode=require"
# Migrations: session pooler (5432), also works on IPv4 networks.
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
APP_URL="http://127.0.0.1:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Protects /api/cron/reconcile and detailed /api/health. At least 32 random characters.
CRON_SECRET=""
# Optional: Sentry project DSN for error alerts.
SENTRY_DSN=""
# Set false only after contact details, prices, policies and availability are verified.
DEMO_MODE="true"
# Used only by `npm run admin:create`. Never keep real values here or commit them.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Optional: WhatsApp alerts to the owner for new, paid and confirmed orders (Meta WhatsApp Cloud API).
# Alerts stay off until all three are set. See DEPLOYMENT.md section 9.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
OWNER_WHATSAPP="918111935267"
# Defaults: approved template "booking_alert" in language "en".
WHATSAPP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG=""
