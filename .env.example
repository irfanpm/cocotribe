# Supabase PostgreSQL. Copy exact host/user from Supabase > Connect.
# URL-encode special characters in the database password.
# Runtime: transaction pooler (6543), compatible with Prisma 6 / Vercel.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require"
# Migrations: session pooler (5432), also works on IPv4 networks.
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
APP_URL="http://127.0.0.1:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Set false only after contact details, prices, policies and availability are verified.
DEMO_MODE="true"
# Required only by admin:create; never use NEXT_PUBLIC_ for secrets.
ADMIN_EMAIL="admin@cocotribe.in"
ADMIN_PASSWORD="cocotribe@saaf000"
